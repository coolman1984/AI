{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman/schemas/tool.schema.json",
  "title": "FOREMAN Tool Manifest Entry",
  "description": "Schema for registry/tools.yaml entries — passports for deterministic engines.",
  "type": "object",
  "required": [
    "tool_id", "name", "purpose", "engine_path",
    "read_only_or_write", "risk_level"
  ],
  "properties": {
    "tool_id": {
      "type": "string",
      "pattern": "^T-[A-Z]{2,4}-\\d{3}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "purpose": { "type": "string", "minLength": 10 },
    "engine_path": { "type": "string", "minLength": 1 },
    "input_schema": { "type": "object" },
    "output_schema": { "type": "object" },
    "allowed_file_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "read_only_or_write": {
      "type": "string",
      "enum": ["read", "write"]
    },
    "side_effects": { "type": "string" },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "approval_required": { "type": "boolean" },
    "validation_method": { "type": "string" },
    "example_call": { "type": "string" },
    "failure_modes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "fallback_tool": {
      "type": "string",
      "pattern": "^T-[A-Z]{2,4}-\\d{3}$"
    }
  }
}
