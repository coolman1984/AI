{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman/schemas/skill.schema.json",
  "title": "FOREMAN Skill Registry Entry",
  "description": "Schema for registry/skills.yaml entries — one per registered skill.",
  "type": "object",
  "required": [
    "skill_id", "name", "domain", "purpose", "triggers",
    "allowed_tools", "risk_level", "version"
  ],
  "properties": {
    "skill_id": {
      "type": "string",
      "pattern": "^SK-\\d{3}$"
    },
    "name": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "string",
      "enum": ["data_ingestion", "analysis", "reporting", "documents", "memory"]
    },
    "purpose": { "type": "string", "minLength": 10 },
    "triggers": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "anti_triggers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "optional_inputs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string", "pattern": "^T-[A-Z]{2,4}-\\d{3}$" },
      "minItems": 1
    },
    "forbidden_actions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "output_types": {
      "type": "array",
      "items": { "type": "string" }
    },
    "validation_rules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "approval_required": { "type": "boolean" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version"
    },
    "owner": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SK-\\d{3}$" }
    },
    "known_failures": {
      "type": "array",
      "items": { "type": "string" }
    },
    "test_cases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "last_updated": { "type": "string", "format": "date" },
    "status": {
      "type": "string",
      "enum": ["proposed", "active", "archived"]
    }
  }
}
