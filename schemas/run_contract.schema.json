{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foreman/schemas/run_contract.schema.json",
  "title": "Run Contract",
  "description": "Schema for FOREMAN run contracts — agreed before work starts.",
  "type": "object",
  "required": [
    "task_id", "user_goal", "sensitive_data_level",
    "selected_skills", "risk_level", "definition_of_done"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "pattern": "^RUN-\\d{4}-\\d{2}-\\d{2}-\\d{3}$",
      "description": "Unique run identifier: RUN-YYYY-MM-DD-NNN"
    },
    "created": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved", "running", "done", "blocked", "failed"],
      "default": "proposed"
    },
    "user_goal": {
      "type": "string",
      "minLength": 1,
      "description": "One sentence in the owner's plain English"
    },
    "input_files": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths to source files, once registered"
    },
    "sensitive_data_level": {
      "type": "string",
      "enum": ["tier1_inhouse", "tier2_cloud_ok"],
      "default": "tier1_inhouse"
    },
    "selected_skills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^SK-\\d{3}$" },
      "minItems": 1
    },
    "selected_tools": {
      "type": "array",
      "items": { "type": "string", "pattern": "^T-[A-Z]{2,4}-\\d{3}$" }
    },
    "constraints": { "type": "string" },
    "expected_outputs": { "type": "string" },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "approval_required_before_start": { "type": "boolean" },
    "validation_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_required": {
      "type": "array",
      "items": { "type": "string" }
    },
    "report_required": { "type": "string" },
    "second_brain_update_expected": { "type": "boolean" },
    "definition_of_done": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  }
}
